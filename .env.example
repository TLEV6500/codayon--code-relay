# Docker Compose configuration for @codayon.
# 
# Copy this file to .env (git-ignored) and modify values as needed.
# docker-compose.yml reads from .env if present; these are the defaults.

# nginx reverse proxy entry point (dev + prod profiles)
NGINX_PORT=8080

# Server runtime
SERVER_PORT=3000

# Client dev server (dev profile only)
CLIENT_PORT=5173

# CORS origin for the server (if ever implemented; currently wide-open cors())
# CORS_ORIGIN=http://localhost:3000
