# Normalize line endings for all files to LF (Unix style)
# This prevents CRLF (Windows style) line endings from being introduced
# by contributors on different OS/editor setups, which can break shell scripts
# and other tools that are sensitive to line ending types.

* text=auto eol=lf

# Explicitly enforce LF for shell scripts and config files
*.sh text eol=lf
*.conf text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.md text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.css text eol=lf
*.html text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.lock binary
